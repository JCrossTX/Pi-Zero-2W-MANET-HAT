	(text "MM8108 Wi-Fi HaLow radio (SPI host, ext-FEM RF).\nOpenMANET pinout: CS0=GPIO8, RST=GPIO17, PWR=GPIO23/24, IRQ=GPIO5.\nRF_900 -> external E21 FEM. FEM_TX/FEM_RX drive E21 T/R.\nDetailed pinout/power-seq are NDA -> fill from vendor ref design." (exclude_from_sim no) (at 20 22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5639bbba-53fe-48c6-bff2-bbe26260dd98"))
