	(text "MM8108 Wi-Fi HaLow radio U1 (SPI host, ext-FEM RF).\nOpenMANET pinout: CS0=GPIO8, RST=GPIO17, PWR=GPIO23/24, IRQ=GPIO5.\nRF_900 -> external E21 FEM. FEM_TX/FEM_RX drive E21 T/R.\nDetailed pinout/power-seq are NDA -> fill from vendor ref design." (exclude_from_sim no) (at 20 22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "778febbf-60a7-4d86-b07b-f0eeef6d3239"))
