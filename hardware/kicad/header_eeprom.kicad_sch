	(text "40-pin female header J1 + HAT ID EEPROM U6 (24Cxx on ID_SD/ID_SC).\nU6 VCC = 3V3_PI (Pi 3V3, pin1) so it reads at boot. WP=protected default.\nAll header nets land here. See docs/INTERFACES.md for the full map." (exclude_from_sim no) (at 20 22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8f51de35-3d6e-4b0f-a15a-c798ec40eb58"))
