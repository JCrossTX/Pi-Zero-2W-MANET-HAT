	(text "u-blox NEO-M9N U3 (UART0 + 1PPS GPIO18, I2C1). VCC via FB1.\nRF_GNSS <- J2 U.FL1 -> C44 -> RF_IN(11); VCC_RF(9) -> L40 bias; D8 ESD.\nRV-3028 RTC U13 on I2C1 (0x52), trickle-charged BT1 solder cell.\nRTC_INT -> GPIO26. 1PPS can discipline the RTC. Keep RF from PA/buck." (exclude_from_sim no) (at 20 22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9e138ac8-374e-4771-b770-673ad7cc4d83"))
