	(lib_symbols)
	(text "ZERO 2W MESH HAT - schematic scaffold (pin labels + nets)\nMM8108-MF15457 HaLow (SPI) + NEO-M9N GNSS + USB-C Ethernet pass-through\nDrop real symbols on top and wire to the matching global labels. See docs/MESH_HAT_SCHEMATIC.md." (exclude_from_sim no) (at 20 12 0) (effects (font (size 2 2) (thickness 0.3)) (justify left top)) (uuid "18843afa-3058-4bf7-9f25-df013ed9b572"))
	(text "U1  MM8108-MF15457  (HaLow, SPI host)" (exclude_from_sim no) (at 25 40 0) (effects (font (size 1.6 1.6) (thickness 0.25)) (justify left top)) (uuid "1e609d98-a472-4236-9c9f-2a37e2e8d88e"))
	(text "2  ANT      -> RF_900 -> C(100pF) -> J3 U.FL ; D4 ESD\n4  RESET_N  <- MM_RESET (J1.11/GPIO17) + U9 ; 10k UP\n5  WAKE     <- MM_PWR2 (J1.18/GPIO24)\n10 VBAT     <- +3V3_RAD ; 10uF+100nF\n12 SPI_MISO -> SPI_MISO (J1.21/GPIO9) ; 10k UP\n13 SPI_CS   -> SPI_CS   (J1.24/GPIO8)  ; 10k UP\n14 SPI_INT  -> MM_IRQ   (J1.29/GPIO5)  ; 10k UP\n15 SDIO_D2  -> 10k UP (+3V3_RAD)\n16 SPI_MOSI -> SPI_MOSI (J1.19/GPIO10)\n17 SPI_SCK  -> SPI_SCLK (J1.23/GPIO11)\n22 VDDIO    <- +3V3_RAD ; 100nF\n24 VBAT_TX  <- +3V3_RAD ; 10uF+100nF+22uF\n25 VDD_USB  : term per ds (USB unused)\n27/28 USBDN/P : NC   29 BUSY: spare\n6-9 JTAG: NC   18,19,21,31-37 GPIO: spare\n1,3,11,20,23,26,30,38 GND" (exclude_from_sim no) (at 25 46 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "81ccb246-718b-4205-a4fc-58e307f091b8"))
	(text "U2  NEO-M9N-00B  (GNSS, UART+I2C)" (exclude_from_sim no) (at 170 40 0) (effects (font (size 1.6 1.6) (thickness 0.25)) (justify left top)) (uuid "21910cb9-da91-49cd-a4b1-12c6694de3c3"))
	(text "1  SAFEBOOT_N 10k UP +3V3_GNSS\n2  D_SEL      open/10k UP (UART+I2C)\n3  TIMEPULSE -> GNSS_PPS (J1.12/GPIO18)\n4  EXTINT    -> GNSS_EXTINT (J1.15/GPIO22)\n8  RESET_N   <- GNSS_RESET (J1.13/GPIO27);10k UP\n9  VCC_RF    -> L2(27-68nH) -> RF_GNSS (bias)\n11 RF_IN     <- C(100pF) <- J2 U.FL ; D3 ESD\n18 SDA       -> GNSS_SDA (J1.3/GPIO2)\n19 SCL       -> GNSS_SCL (J1.5/GPIO3)\n20 TXD       -> GNSS_TXD -> Pi RXD0 (J1.10)\n21 RXD       <- GNSS_RXD <- Pi TXD0 (J1.8)\n22 V_BCKP    <- +3V3_GNSS\n23 VCC       <- +3V3_GNSS (FB1) ; 10uF+100nF\n5,6,7 USB/V_USB: NC   14 LNA_EN: NC\n15-17 Reserved: NC   10,12,13,24 GND" (exclude_from_sim no) (at 170 46 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "abac0013-3ec5-4e8a-a810-f2f37f85824e"))
	(text "POWER" (exclude_from_sim no) (at 320 40 0) (effects (font (size 1.6 1.6) (thickness 0.25)) (justify left top)) (uuid "bc8d5573-ec6b-4752-87d8-8e91b9965c53"))
	(text "+5V (J1.2,4) -> D2 SMAJ5.0A -> U7 TPS22965 -> +5V_SW\n+5V_SW -> U5 TLV62569 + L1 2.2uH -> +3V3\n+3V3 -> U8 TPS22918 (EN=MM_PWR1 J1.16) -> +3V3_RAD\n+3V3 -> FB1 ferrite -> +3V3_GNSS\nU9 TPS3839 on +3V3 -> MM_RESET (10k UP)\n3V3_PI (J1.1,17) -> U6 only (ref rail)" (exclude_from_sim no) (at 320 46 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "11597501-98d6-4c6f-a550-fbdcee867a82"))
	(text "USB-C ETHERNET PASS-THROUGH (no hub)" (exclude_from_sim no) (at 25 140 0) (effects (font (size 1.6 1.6) (thickness 0.25)) (justify left top)) (uuid "f2ee15f0-863b-44c1-aaa7-deaea32ea681"))
	(text "Pi USB host -> cable -> J7 -> board -> J6 -> dongle\nJ7 MicroB D+/D- -> USB_DP/USB_DM ; GND ; VBUS/ID NC\nD1 USBLC6-2 ESD on USB_DP/USB_DM\nJ6 USB-C D+(A6,B6)->USB_DP  D-(A7,B7)->USB_DM\nJ6 VBUS(A4/B4/A9/B9) -> VBUS_C\nJ6 CC1->56k->VBUS_C  CC2->56k->VBUS_C (Rp host)\nU11 FPF2123: IN=+5V OUT=VBUS_C EN=on ILIM~0.5-1A\nPi: dtoverlay=dwc2,dr_mode=host ; OTG cable" (exclude_from_sim no) (at 25 146 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "26cd2120-9031-4ceb-843a-7e983ca1c8d7"))
	(text "U6  24LC32 ID EEPROM  +  LEDs  +  SHIELDS" (exclude_from_sim no) (at 170 140 0) (effects (font (size 1.6 1.6) (thickness 0.25)) (justify left top)) (uuid "d2a9a139-538b-4eb7-b9c5-762fd89ab182"))
	(text "U6 VCC=3V3_PI  GND  SDA=ID_SD(J1.27) SCL=ID_SC(J1.28)\n   A0/A1/A2=GND  WP=10k UP 3V3_PI + JP->GND\n   2x 3.9k pulls SDA/SCL -> 3V3_PI\nD_PWR <- +3V3 (1k)\nD_FIX <- LED_FIX (J1.32/GPIO12) (1k)\nD_TX  <- LED_TX  (J1.33/GPIO13) (1k)\nSH1 (GNSS) / SH2 (MM8108) frames -> GND  [DNP]" (exclude_from_sim no) (at 170 146 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "468e05ab-eba4-403c-a765-f838aaa858a7"))
	(text "J1  Pi 40-pin header (key pins)" (exclude_from_sim no) (at 320 140 0) (effects (font (size 1.6 1.6) (thickness 0.25)) (justify left top)) (uuid "25266735-f709-48b3-8017-b2092ee7d252"))
	(text "1,17 3V3_PI   2,4 +5V   GND:6/9/14/20/25/30/34/39\nSPI0: 19 MOSI 21 MISO 23 SCLK 24 CE0/CS\n29 GPIO5 IRQ  11 GPIO17 RST  16 GPIO23 PWR1  18 GPIO24 PWR2\nUART0: 8 TXD0  10 RXD0   12 GPIO18 PPS\nI2C1: 3 SDA  5 SCL   13 GPIO27 GNSS_RST  15 GPIO22 EXTINT\n27 ID_SD  28 ID_SC   32 GPIO12 LED_FIX  33 GPIO13 LED_TX" (exclude_from_sim no) (at 320 146 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "86f43ab4-6bf3-42f6-a5d5-f9350741be03"))
